# Copy to .env (or export in your shell). Nothing here is required to run the project offline.
DATABASE_URL=postgresql+psycopg2://ci:ci@localhost:5432/netflix_ci
DATABASE_URL_RO=postgresql+psycopg2://ci_readonly:ci_readonly@localhost:5432/netflix_ci
ANTHROPIC_API_KEY=            # optional: enables free-form AI answers. Leave empty for offline (rule-based) mode.
COPILOT_MODEL=claude-sonnet-5-5
COPILOT_MAX_ROWS=500
COPILOT_TIMEOUT_S=15
